# ANOS 环境变量示例
# 复制此文件为 .env 并根据实际环境修改

# 数据库路径 (相对于 services/api)
ANOS_DB_PATH=./data/anos.db

# API 服务端口
PORT=3001

# Portal 前端端口 (Next.js 默认 3000)
NEXT_PUBLIC_API_URL=http://localhost:3001

# JWT 密钥 (生产环境必须修改)
JWT_SECRET=change-me-in-production

# 飞书集成 (Phase 2)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_ID=
FEISHU_BITABLE_ID=

# ERP 集成 (Phase 2)
ERP_API_URL=
ERP_API_KEY=
