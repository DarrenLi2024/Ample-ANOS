# ============================================================================
# ANOS 环境变量配置
# 复制此文件为 .env 并根据实际环境修改
# ============================================================================

# ---- 运行环境 ----
NODE_ENV=development

# ---- 数据库 ----
ANOS_DB_PATH=./data/anos.db

# ---- API 服务 ----
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ---- 安全 ----
# JWT 密钥 (生产环境必须修改为随机字符串)
JWT_SECRET=change-me-in-production-use-256-bit-random
# 速率限制: 每窗口请求数
RATE_LIMIT_MAX=100
# 速率限制: 窗口时间(毫秒)
RATE_LIMIT_WINDOW_MS=60000
# 请求体最大大小(字节)
MAX_BODY_SIZE=10485760

# ---- Portal 前端 (NEXT_PUBLIC_ 前缀会暴露到浏览器) ----
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- 飞书集成 (Phase 2) ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_ID=
FEISHU_BITABLE_ID=

# ---- ERP 集成 (Phase 2) ----
ERP_API_URL=
ERP_API_KEY=

# ---- OpenTelemetry (Phase 2) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
